# OS
.DS_Store

# Local editor/tooling settings
.claude/

# Derived interaction file — regenerable from cf_submissions.jsonl via build_interactions.py
cprs/data/interactions/events_filtered.jsonl

# Hugging Face release payload — regenerable via scripts/export_hf_dataset.py
cprs/data/hf_release/

# SQLite DB with real user credentials (password hashes, sessions) — never publish
cprs/data/*.db
cprs/data/*.db-shm
cprs/data/*.db-wal

# Personal working notes — build planning, research log, methods crib sheet.
# Private scratch material, not part of the submitted project.
cprs/DECISIONS_LOG.md
cprs/FINAL_PROJECT_PLAN.md
cprs/METHODS.md

# Copyrighted University of London course materials (exam papers, templates, rubric)
*.pdf
rubric/
preliminary_report_requirements.txt

# Derived report statistics — regenerable from the dataset via scripts/report_stats.py
cprs/data/report_stats.json

# LaTeX build artifacts (report PDF is regenerable from the .tex source)
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Report sources and project paperwork — submitted through the report
# hand-in, not through the code repository.
CLAUDE.md
REQUIREMENTS.md
preliminary_report_feedback.md
cprs/final_report.tex
cprs/preliminary_report.md
cprs/preliminary_report.tex
cprs/requirements.txt
